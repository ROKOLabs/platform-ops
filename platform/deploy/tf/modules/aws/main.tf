# Public entry point. CI vendors the shared implementation and stamps the release.
module "implementation" {
  source = "../../shared/aws"
  name                               = var.name
  region                             = var.region
  ingress_host                       = var.ingress_host
  api_allowed_cidrs                  = var.api_allowed_cidrs
  vpc_cidr                           = var.vpc_cidr
  private_subnet_cidrs               = var.private_subnet_cidrs
  public_subnet_cidrs                = var.public_subnet_cidrs
  azs                                = var.azs
  high_availability                  = var.high_availability
  node_pools                         = var.node_pools
  kubernetes_version                 = var.kubernetes_version
  admin_principal_arns               = var.admin_principal_arns
  viewer_principal_arns              = var.viewer_principal_arns
  grant_terraform_principal_admin    = var.grant_terraform_principal_admin
  tls_mode                           = var.tls_mode
  tls_certificate_arn                = var.tls_certificate_arn
  restrict_origin_to_cloudflare      = var.restrict_origin_to_cloudflare
  extra_origin_cidrs                 = var.extra_origin_cidrs
  db_instance_class                  = var.db_instance_class
  db_allocated_storage               = var.db_allocated_storage
  db_engine_version                  = var.db_engine_version
  db_apply_immediately               = var.db_apply_immediately
  db_backup_retention_days           = var.db_backup_retention_days
  db_deletion_protection             = var.db_deletion_protection
  image_registry                     = var.image_registry
  image_names                        = var.image_names
  image_tag                          = var.image_tag
  chart_values                       = var.chart_values
  uploads_bucket_name                = var.uploads_bucket_name
  checkpoints_bucket_name            = var.checkpoints_bucket_name
  ecr_repository_names               = var.ecr_repository_names
  artifact_cors_origins              = var.artifact_cors_origins
  agent_bedrock_model_arns           = var.agent_bedrock_model_arns
  agent_checkpoint_prefix            = var.agent_checkpoint_prefix
  agent_checkpoint_expiration_days   = var.agent_checkpoint_expiration_days
  agent_node_idle_timeout            = var.agent_node_idle_timeout
  keda_chart_version                 = var.keda_chart_version
  monthly_budget_usd                 = var.monthly_budget_usd
  budget_notify_emails               = var.budget_notify_emails
  telemetry                          = var.telemetry
  external_secrets_chart_version     = var.external_secrets_chart_version
  tags                               = var.tags
  plan_principal_arns                = var.plan_principal_arns
  chart_path                         = var.chart_path
  chart_version                      = var.chart_version
  chart_repository                   = var.chart_repository
  existing_encryption_secret_name    = var.existing_encryption_secret_name
  manage_agent_node_pool             = var.manage_agent_node_pool
  viewer_principal_kubernetes_groups = var.viewer_principal_kubernetes_groups
  ecr_untagged_expiry_days           = var.ecr_untagged_expiry_days
  external_admin_principal_arns      = var.external_admin_principal_arns
  network_tags                       = var.network_tags
}
