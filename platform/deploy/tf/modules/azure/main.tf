# Public entry point. CI vendors the shared implementation and stamps the release.
module "implementation" {
  source = "../../shared/azure"
  name                                  = var.name
  resource_prefix                       = var.resource_prefix
  location                              = var.location
  ingress_host                          = var.ingress_host
  vnet_cidr                             = var.vnet_cidr
  aks_subnet_cidr                       = var.aks_subnet_cidr
  postgres_subnet_cidr                  = var.postgres_subnet_cidr
  kubernetes_version                    = var.kubernetes_version
  api_allowed_cidrs                     = var.api_allowed_cidrs
  zones                                 = var.zones
  high_availability                     = var.high_availability
  postgres_sku_name                     = var.postgres_sku_name
  storage_account_name                  = var.storage_account_name
  acr_name                              = var.acr_name
  acr_enabled                           = var.acr_enabled
  key_vault_name                        = var.key_vault_name
  postgres_server_name                  = var.postgres_server_name
  tls_mode                              = var.tls_mode
  restrict_origin_to_cloudflare         = var.restrict_origin_to_cloudflare
  extra_origin_cidrs                    = var.extra_origin_cidrs
  ingress_nginx_chart_version           = var.ingress_nginx_chart_version
  ingress_nginx_external_traffic_policy = var.ingress_nginx_external_traffic_policy
  image_registry                        = var.image_registry
  image_names                           = var.image_names
  image_tag                             = var.image_tag
  chart_values                          = var.chart_values
  uploads_container_name                = var.uploads_container_name
  checkpoints_container_name            = var.checkpoints_container_name
  artifact_cors_origins                 = var.artifact_cors_origins
  foundry                               = var.foundry
  telemetry                             = var.telemetry
  roles_granted_by_client               = var.roles_granted_by_client
  key_vault_authorization               = var.key_vault_authorization
  key_vault_soft_delete_retention_days  = var.key_vault_soft_delete_retention_days
  extra_secrets_officer_object_ids      = var.extra_secrets_officer_object_ids
  agent_node_idle_timeout               = var.agent_node_idle_timeout
  agent_node_class_name                 = var.agent_node_class_name
  external_secrets_chart_version        = var.external_secrets_chart_version
  tags                                  = var.tags
}
